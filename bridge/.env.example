# 复制成 .env（已 gitignore）。Railway 上则是填进 service 的 Variables。

# Worker 的位址，结尾不要带斜线
WORKER_URL=https://rasa-crm.appleautumn-hhl.workers.dev

# 跟 Worker 的 WA_BRIDGE_SECRET 必须一模一样。自己产一串长的随机值。
WA_BRIDGE_SECRET=

# Cloudflare Access Service Token。Access 挡在 Worker 前面，
# 桥接机没有浏览器、收不到 OTP，靠这两个标头进去。
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# WhatsApp 登入状态存放处。Railway 要把 Volume 挂在 /data，
# 存在这里重启才不用重新扫码。
AUTH_DIR=/data/auth

# 本机测试用（没有 /data 时）
# AUTH_DIR=./.auth
