{
  "name": "rasa-crm-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute rasa-crm --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute rasa-crm --remote --file=./seed.users.sql",
    "db:list": "wrangler d1 execute rasa-crm --remote --command=\"SELECT email, name, role FROM users ORDER BY role, email\"",
    "test": "node --test test/*.test.mjs",
    "access:setup": "node scripts/setup-access.mjs",
    "build": "npm run build:css && npm run build:js",
    "db:init:local": "wrangler d1 execute rasa-crm --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute rasa-crm --local --file=./seed.users.sql",
    "build:css": "tailwindcss -i app/styles.css -o public/app.css --minify",
    "build:js": "esbuild app/main.jsx --bundle --minify --format=iife --loader:.jsx=jsx --define:process.env.NODE_ENV='\"production\"' --outfile=public/app.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
